# Copy this file to .env and fill in your own values. Never commit .env.

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=gsk

# Optional: Groq model to use. llama-3.3-70b-versatile is a strong default.
# Faster/cheaper alternative: llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# Optional: port the server listens on
PORT=3000

# Optional: lock the API down to your real website origin(s) once deployed.
# Comma-separate multiple origins. Leave as * only for local testing.
# Example: ALLOWED_ORIGIN=https://blss.ac.tz,https://www.blss.ac.tz
ALLOWED_ORIGIN=*
